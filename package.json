{
  "name": "mtm-shift-booking-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "demo": "DEMO_MODE=true DATABASE_PATH=.local/demo.sqlite npm run dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "create-user": "tsx scripts/create-user.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "backup": "tsx scripts/backup.ts",
    "check:airtable": "tsx scripts/check-airtable.ts",
    "test:accounts": "tsx scripts/browser-accounts.ts",
    "test:import": "tsx scripts/browser-import.ts",
    "test:qol": "tsx scripts/browser-qol.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.30.0",
    "zod": "^4.1.12",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
