# Local app development: `npm run demo` uses separate fictional data.
# Never enable demo mode for a real deployment.
DEMO_MODE=false
DATABASE_PATH=.local/support.sqlite
PORT=3001
# Set to the browser-facing origin when using a domain or reverse proxy.
# Production requires HTTPS and NODE_ENV=production.
# PUBLIC_ORIGIN=https://support.example.com
# First-coordinator browser setup requires a random key of at least 32 characters.
# Render generates this automatically; enter it securely for other hosts.
# MTM_SETUP_SECRET=

# Enter a scoped Airtable PAT securely on the server, never in browser code.
# AIRTABLE_PAT=
# AIRTABLE_BASE_ID=app...
# AIRTABLE_PARTICIPANTS_TABLE=Participants
# The existing table names confirmed by the team:
AIRTABLE_EVENTS_TABLE=Events
AIRTABLE_RSVPS_TABLE=RSVPs
AIRTABLE_SHIFTS_TABLE=Shift Requests
# Explicitly enable only after reviewing actual fields and existing requests.
AIRTABLE_SYNC_ENABLED=false
# Optional JSON mappings documented in docs/AIRTABLE.md.
# AIRTABLE_FIELD_MAP={}
# AIRTABLE_STAFF_RECORD_MAP={}
# Workers refresh on startup and every five minutes, independently of outgoing request sync.
# Defaults match MTM's Staff table; active volunteers are included, archived staff excluded.
# AIRTABLE_STAFF_TABLE=Staff
# AIRTABLE_STAFF_NAME_FIELD=Name
# AIRTABLE_STAFF_STATUS_FIELD=Status
# AIRTABLE_STAFF_ARCHIVED_FIELD=Archived
# AIRTABLE_STAFF_ACTIVE_STATUSES=["Active","Active - Volunteer","Pending Superannuation Xero Input"]
# Historical delivered 1:1 sessions for assignment counts (read-only).
# AIRTABLE_WORK_HISTORY_TABLE=1:1 Log
# Connecteam read-only setup check; this release does not publish shifts.
# One-off import: off by default. Preview before applying, then return to off.
# CONNECTEAM_IMPORT_MODE=off
# CONNECTEAM_IMPORT_RUN_ID=nsw-initial-roster
# CONNECTEAM_IMPORT_START_DATE=2026-02-01
# CONNECTEAM_API_KEY=
# CONNECTEAM_SCHEDULER_NAME=NSW
# CONNECTEAM_SCHEDULER_ID=
# AIRTABLE_SHIFT_STATUS_MAP={}
# AIRTABLE_SHIFT_VALUE_MAP={}
# Actual base maps are in docs/airtable-field-map.json and docs/airtable-shift-value-map.json.
# AIRTABLE_SUPPORT_TYPE_MAP={"Recommended":"none"}
# AIRTABLE_RSVP_STATUS_MAP={"Active":"attending","Dropped":"cancelled"}
# A long random shared secret, entered securely on server and automation.
# RSVP_WEBHOOK_SECRET=
